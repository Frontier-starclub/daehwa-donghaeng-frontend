# Standalone AI: copy to ai/.env and run uvicorn app.main:app --port 8100.
# For Compose, use client-repo/.env.example instead.
PROVIDER_MODE=remote
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
DATA_GO_KR_SERVICE_KEY=
# Optional Claude configuration: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5
CHAT_MODEL=claude-opus-5
# Offline mode: PROVIDER_MODE=mock
