# 이 파일을 .env로 복사한 뒤 키를 입력하세요. 키는 AI 서버에만 전달합니다.
PROVIDER_MODE=remote
AI_PROVIDER_MODE=remote
AI_SERVICE_TIMEOUT=45
BACKEND_BUILD_CONTEXT=../../daehwa-donghaeng/apps/backend
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
# LLM_PROVIDER=anthropic uses the Claude key/models below instead.
ANTHROPIC_API_KEY=
# 공공데이터포털 DUR 품목정보 서비스의 Decoding 인증키
DATA_GO_KR_SERVICE_KEY=
OCR_MODEL=claude-opus-5
CHAT_MODEL=claude-opus-5
# API 키 없이 서버 연결 확인: AI_PROVIDER_MODE=mock
