# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다.

# mock = 외부 API를 호출하지 않고 고정 응답 (기본값, 키 없이 전체 흐름 확인 가능)
# remote = 실제 Claude API / 식약처 API 호출
AI_PROVIDER_MODE=mock

# 약봉투 OCR, 말벗 대화 응답
ANTHROPIC_API_KEY=

# 식약처 공개 API (DUR 품목정보, 낱알식별, e약은요)
DATA_GO_KR_SERVICE_KEY=

# 통합 실행 시 백엔드 provider 모드 (compose.integration.yaml)
# remote 로 바꾸려면 백엔드에 어댑터가 머지되어 있어야 합니다.
BACKEND_PROVIDER_MODE=mock
